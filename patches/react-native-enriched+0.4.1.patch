+// PATCH (atomic mentions): when a single backspace would delete a character
+// that belongs to a finalized mention, remove the WHOLE mention instead of
+// editing it one letter at a time.
+- (BOOL)handleMentionBackspace:(NSRange)range
+               replacementText:(NSString *)text {
+  // Only a plain backspace: deleting exactly one character, no replacement.
+  if (text.length != 0 || range.length != 1) {
+    return NO;
+  }
+  NSUInteger location = range.location;
+  if (location >= _input->textView.textStorage.length) {
+    return NO;
+  }
+
+  // Only act when the deleted character itself belongs to a finalized mention.
+  // A character that merely sits next to a mention (e.g. the trailing space)
+  // is deleted normally — the mention goes only on the *next* backspace. This
+  // also lets the user type right next to a mention without removing it.
+  if ([self getMentionParamsAt:location] == nullptr) {
+    return NO;
+  }
+
+  NSRange mentionRange = [self getFullMentionRangeAt:location];
+  if (mentionRange.length == 0) {
+    return NO;
+  }
+
+  // Clear the mention attributes, then delete the whole mention range.
+  [self removeAttributes:mentionRange];
+  [TextInsertionUtils replaceText:@""
+                               at:mentionRange
+             additionalAttributes:nullptr
+                            input:_input
+                    withSelection:YES];
+  return YES;
+}
