{
  "name": "PortfolioApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android:dev": "NODE_ENV=development react-native run-android",
    "android:prod": "NODE_ENV=production react-native run-android",
    "ios:dev": "NODE_ENV=development react-native run-ios",
    "ios:prod": "NODE_ENV=production react-native run-ios",
    "reset:cache": "watchman watch-del-all && watchman shutdown-server || true && rm -rf $TMPDIR/react-* && react-native start --reset-cache",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "ios:clean": "cd ios && xcodebuild clean || true && cd ..",
    "android:clean-install": "rm -rf node_modules package-lock.json yarn.lock android/.gradle android/.cxx android/app/build android/build && npm install && cd android && ./gradlew clean && cd .. && npm run reset:cache && npm run android:dev",
    "ios:clean-install": "rm -rf node_modules package-lock.json yarn.lock ios/Pods ios/Podfile.lock android/.gradle android/.cxx android/app/build android/build && npm install && cd ios && pod install && cd .. && npm run reset:cache && npm run ios:dev",
    "fresh-install": "rm -rf node_modules package-lock.json yarn.lock ios/Pods ios/Podfile.lock android/.gradle android/.cxx android/app/build android/build && npm install && cd ios && pod install && cd .. && npm run reset:cache"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.81.1",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@reduxjs/toolkit": "^2.9.0",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-indicators": "^0.17.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^10.0.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "^4.1.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "^15.13.0",
    "react-native-worklets": "^0.5.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-indicators": "^0.16.6",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
