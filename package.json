{
  "name": "PortfolioApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test": "jest",
    "postinstall": "patch-package",
    "android:dev": "NODE_ENV=development react-native run-android",
    "android:prod": "NODE_ENV=production react-native run-android",
    "ios:dev": "NODE_ENV=development react-native run-ios",
    "ios:prod": "NODE_ENV=production react-native run-ios",
    "android:clean": "cd android && ./gradlew clean",
    "ios:clean": "cd ios && xcodebuild clean || true",
    "clean:js": "rm -rf node_modules package-lock.json yarn.lock",
    "clean:android": "rm -rf android/.gradle android/.cxx android/app/build android/build",
    "clean:ios": "rm -rf ios/Pods ios/Podfile.lock ios/build",
    "clean:cache": "watchman watch-del-all; watchman shutdown-server; rm -rf $TMPDIR/react-* $TMPDIR/metro-*",
    "reset-cache": "npm run clean:cache; react-native start --reset-cache",
    "android:clean-install": "npm run clean:js && npm run clean:android && npm install && npm run clean:cache && npm run android:dev",
    "ios:clean-install": "npm run clean:js && npm run clean:ios && npm install && cd ios && pod install && cd .. && npm run clean:cache && npm run ios:dev",
    "fresh-install": "npm run clean:js && npm run clean:android && npm run clean:ios && npm install && cd ios && pod install && cd .. && npm run reset-cache"
  },
  "dependencies": {
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native-firebase/app": "23.8.8",
    "@react-native-firebase/auth": "23.8.8",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-masked-view/masked-view": "^0.2.8",
    "@react-native/new-app-screen": "0.81.1",
    "@react-navigation/drawer": "^7.12.2",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@reduxjs/toolkit": "^2.9.0",
    "axios": "^1.16.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-biometrics": "^3.0.1",
    "react-native-enriched": "^0.4.1",
    "react-native-file-viewer": "^2.1.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^4.3.1",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "^4.4.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.16.0",
    "react-native-share": "^12.2.2",
    "react-native-simple-toast": "^3.3.2",
    "react-native-size-matters": "^0.4.2",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-ssl-public-key-pinning": "^1.2.6",
    "react-native-svg": "^15.15.5",
    "react-native-view-shot": "^5.1.0",
    "react-native-worklets": "^0.9.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-indicators": "^0.16.6",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.portfolioapp"
    }
  }
}
